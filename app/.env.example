DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MAPBOX_PUBLIC_TOKEN=pk.replace_with_restricted_public_token
ANTHROPIC_API_KEY=replace_with_server_only_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=https://replace-with-production-origin.example
RESEND_API_KEY=replace_with_server_only_key
RESEND_FROM_EMAIL=Groundtruth <auth@replace-with-verified-domain.example>
TURNSTILE_SITE_KEY=replace_with_public_site_key
TURNSTILE_SECRET_KEY=replace_with_server_only_key

# Geocodio approved for free-tier-only commute address lookups.
# Use an account with paid usage disabled; the app additionally caps 1,000/day.
GEOCODIO_API_KEY=
GEOCODIO_FREE_TIER_ONLY=false

# Private operator route also requires an explicit operator_roles admin row.
GROUNDTRUTH_OPERATOR_ENABLED=false
